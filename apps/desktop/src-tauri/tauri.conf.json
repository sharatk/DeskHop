{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskHop",
  "mainBinaryName": "DeskHop",
  "version": "0.1.0",
  "identifier": "com.deskhop.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "DeskHop", "width": 800, "height": 600 }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
